
# ---------------------------------------------------------------------------
# M12: turn commit barrier.
#
# Isolated target: the guard has no dependency beyond glib, and nothing in the
# application links it yet. Wiring it into OllamaProvider and
# ConversationSession is a separate change.
# ---------------------------------------------------------------------------

conversation_turn_guard_test = executable(
  'conversation-turn-guard-test',
  ['src/conversation_turn_guard.c',
   'tests/conversation_turn_guard_test.c'],
  include_directories: include_directories('src'),
  dependencies: [glib_dep],
  install: false
)
test('conversation-turn-guard', conversation_turn_guard_test)
